{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1235/v1"
      },
      "models": {
        "bonsai-9b": {
          "name": "Ternary-Bonsai-2-9B (local)",
          "limit": {
            "context": 100000,
            "output": 16384
          }
        },
        "bonsai-27b": {
          "name": "Ternary-Bonsai-2-27B (local)",
          "limit": {
            "context": 50000,
            "output": 16384
          }
        },
        "bonsai-ptq1": {
          "name": "Ternary-Bonsai-2-27B-PTQ1_0 (local)",
          "limit": {
            "context": 50000,
            "output": 16384
          }
        },
        "bonsai-2-5-27b": {
          "name": "Ternary-Bonsai-2-5-27B (local)",
          "limit": {
            "context": 100000,
            "output": 16384
          }
        },
        "bonsai-2-5-27b-mtp": {
          "name": "Ternary-Bonsai-2-5-27B MTP (local)",
          "limit": {
            "context": 100000,
            "output": 16384
          }
        }
      }
    }
  },
  "skills": [
    "./skills/discover-repo",
    "./skills/tool-call",
    "./skills/repo-knowledge",
    "./skills/bash-check"
  ],
  "instructions": [
    "/home/admin/.config/opencode/AGENTS.md",
    "/home/admin/.config/opencode/prompts/lire.md",
    "/home/admin/.config/opencode/prompts/auto-upgrade.md",
    "/home/admin/.config/opencode/prompts/recherche.md",
    "/home/admin/.config/opencode/prompts/memory.md",
    "/home/admin/.config/opencode/prompts/confirmation.md",
    "/home/admin/.config/opencode/README.md",
    "/home/admin/.config/opencode/prompts/style/réponse-simple.md",
    "/home/admin/.config/opencode/prompts/style/français.md",
    "/home/admin/.config/opencode/prompts/style/markdown.md",
    "/home/admin/.config/opencode/prompts/error.md"
  ],
  "model": "llama.cpp/bonsai-2-5-27b"
}